{
  "name": "mhrd-session",
  "version-string": "0.1.0",
  "description": "MHRD: окремий процес сеансу RDP над FreeRDP (SPEC → «Архітектура»).",
  "dependencies": [
    {
      "name": "freerdp",
      "default-features": false,
      "features": [
        "client",
        {
          "name": "ffmpeg",
          "platform": "linux | android"
        }
      ]
    },
    {
      "name": "sdl3",
      "platform": "!android"
    },
    {
      "name": "sdl3-ttf",
      "platform": "!android"
    }
  ],
  "builtin-baseline": "d186940b2f0c4e8e5b4ff804af57d2a26fbfa091",
  "vcpkg-configuration": {
    "overlay-ports": ["./vcpkg-overlay"],
    "overlay-triplets": ["./vcpkg-triplets"]
  }
}
