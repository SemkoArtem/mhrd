+/* MHRD: у Windows winpr_str_is_valid_url = PathIsURLA, яка відкидає ім'я вузла без схеми
+ * (host.domain.local, NetBIOS) — і перенаправлення брокером RDS-ферми падало. */
+static BOOL mhrd_valid_host(const char* host)
+{
+	if (!host || !host[0])
+		return FALSE;
+	for (const char* p = host; *p; p++)
+	{
+		if ((unsigned char)*p <= ' ' || *p == '/' || *p == '@')
+			return FALSE;
+	}
+	return TRUE;
+}
