 		WLog_DBG(TAG, "TargetFQDN: %s", redirection->TargetFQDN);
 	}
@@ -810,7 +824,7 @@ static state_run_t rdp_recv_server_redirection_pdu(rdpRdp* rdp, wStream* s)
